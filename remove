#!/bin/bash
# Remove ROS 2 container(s) and image(s): ./remove <distro> | --all
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

usage() {
    cat <<EOF
Usage: ./remove [OPTIONS] <ROS2_DISTRO> [ROS2_DISTRO...]

Stop and delete the container and image for the given distro(s).

Options:
  --all, -a   Remove every distro that has been built
  -h, --help  Show this help

Examples:
  ./remove jazzy
  ./remove --all

EOF
    print_status
}

DISTROS=()
ALL=0
for arg in "$@"; do
    case "$arg" in
        -h|--help)
            usage
            exit 0
            ;;
        --all|-a)
            ALL=1
            ;;
        -*)
            die "unknown option '$arg' (see ./remove --help)"
            ;;
        *)
            DISTROS+=("$arg")
            ;;
    esac
done

if (( ALL )); then
    mapfile -t DISTROS < <(built_distros)
    if [[ ${#DISTROS[@]} -eq 0 ]]; then
        info "nothing to remove: no ros2 images are built"
        exit 0
    fi
elif [[ ${#DISTROS[@]} -eq 0 ]]; then
    usage >&2
    exit 1
fi

for DISTRO in "${DISTROS[@]}"; do
    require_distro "$DISTRO"
    export ROS_DISTRO="$DISTRO"

    if container_exists "$DISTRO"; then
        info "Stopping and removing container $(container_name "$DISTRO")"
        # `compose down` also catches containers created by the old scripts.
        if ! DOWN_OUTPUT=$(compose down --rmi all ros2 2>&1); then
            printf '%s\n' "$DOWN_OUTPUT" >&2
            warn "compose down reported problems for $DISTRO; falling back to direct removal"
        fi
    fi

    # Fallbacks: image/container not created through compose.
    if image_exists "$DISTRO"; then
        info "Removing image $(image_name "$DISTRO")"
        "$ENGINE" rmi -f "$(image_name "$DISTRO")" >/dev/null 2>&1 || true
    fi
    if container_exists "$DISTRO"; then
        "$ENGINE" rm -f "$(container_name "$DISTRO")" >/dev/null 2>&1 || true
    fi
done

refresh_distros_file
info "Cleanup completed for: ${DISTROS[*]}"
