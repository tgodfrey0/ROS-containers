#!/bin/bash
# Start (or attach to) a ROS 2 container: ./run <distro> [-- command...]
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

usage() {
    cat <<EOF
Usage: ./run [OPTIONS] <ROS2_DISTRO> [-- COMMAND [ARG...]]

Start a ROS 2 container as defined in ./compose.yaml (building the image
automatically the first time) and attach a shell to it: a tmux session by
default, a plain bash shell with --no-tmux.

Options:
  --build      Rebuild the image before starting
  --no-tmux    Attach a plain bash shell instead of a tmux session
  -h, --help   Show this help

Examples:
  ./run jazzy                    # tmux inside a jazzy container (rviz/rqt GUIs work)
  ./run --no-tmux jazzy          # plain bash shell, no tmux
  ./run humble                   # any built or unbuilt distro, same command
  ./run --build jazzy            # rebuild the image, then start
  ./run jazzy -- ros2 topic list # run a single command in the container
  ./run jazzy -- bash            # plain shell inside the container

Detach from a running container with Ctrl-g (it keeps running in the
background; './run <distro>' attaches again). In --no-tmux mode just exit
the shell (Ctrl-D); the container keeps running too.

Choosing between tmux and --no-tmux never rebuilds or recreates the
container - only the image build itself (--build or a first run) does.

EOF
    print_status
}

REBUILD=0
NO_TMUX=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --build)
            REBUILD=1
            shift
            ;;
        --no-tmux)
            NO_TMUX=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option '$1' (see ./run --help)"
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
fi

DISTRO="$1"
shift
if [[ "${1:-}" == "--" ]]; then
    shift
fi

require_distro "$DISTRO"
export ROS_DISTRO="$DISTRO"
refresh_distros_file

x11_prepare

# Containers from the pre-compose version of these scripts have no compose
# labels; remove them so `compose up` can recreate them cleanly.
if container_exists "$DISTRO" && ! container_is_compose_managed "$DISTRO"; then
    info "Replacing container '$(container_name "$DISTRO")' created by the old setup"
    "$ENGINE" rm -f "$(container_name "$DISTRO")" >/dev/null 2>&1 || true
fi

# A container whose Xauthority bind source was deleted (old /tmp/xauth_* path,
# wiped at boot) can never start again - podman fails before the entrypoint
# runs. Recreate it instead of failing every time.
if container_exists "$DISTRO" && xauthority_mount_missing "$DISTRO"; then
    warn "container $(container_name "$DISTRO") points at a deleted Xauthority file"
    warn "recreating it (nothing inside it can be kept - it cannot start)"
    "$ENGINE" rm -f "$(container_name "$DISTRO")" >/dev/null 2>&1 || true
fi

# Images and containers from before the entrypoint was made mode-neutral
# have tmux as PID 1, so tmux would be running no matter what ./run attaches
# to. They can only be fixed once - and that does need a rebuild.
if image_exists "$DISTRO" && [[ "$(image_cmd "$DISTRO")" == *ros_entrypoint_tmux.sh* ]]; then
    warn "image $(image_name "$DISTRO") still runs tmux as PID 1"
    warn "run './run --build $DISTRO' once to pick up the mode-neutral entrypoint"
fi
if container_exists "$DISTRO" && [[ "$(container_cmd "$DISTRO")" == *ros_entrypoint_tmux.sh* ]]; then
    warn "container $(container_name "$DISTRO") runs tmux as PID 1 (created from an old image)"
    warn "run './remove $DISTRO' once to recreate it without tmux"
fi

if ! image_exists "$DISTRO"; then
    info "Image $(image_name "$DISTRO") does not exist yet - building it now (first build takes a while)"
elif (( REBUILD )); then
    info "Rebuilding $(image_name "$DISTRO")"
fi

UP_ARGS=(-d)
if (( REBUILD )); then
    # A rebuild produces a new image, so the container must be recreated
    # from it (this also applies any compose.yaml changes).
    UP_ARGS+=(--build --force-recreate)
else
    # Never recreate on a plain start. podman-compose embeds the
    # interpolated config (including DISPLAY/TERM/XAUTHORITY from your
    # shell) in a hash, and recreating on any mismatch would reset the
    # container to the pristine image - losing everything installed with
    # apt/pip inside. Recreation only happens with --build or ./remove.
    UP_ARGS+=(--no-recreate)
fi
info "Starting container $(container_name "$DISTRO")"

# While an image is being built we show compose output live; for a plain
# start we keep the output clean and only show it if something goes wrong.
if image_exists "$DISTRO" && (( ! REBUILD )); then
    if ! UP_OUTPUT=$(compose up "${UP_ARGS[@]}" ros2 2>&1); then
        printf '%s\n' "$UP_OUTPUT" >&2
        die "failed to start $(container_name "$DISTRO")"
    fi
else
    compose up "${UP_ARGS[@]}" ros2 || die "failed to start $(container_name "$DISTRO")"
fi
refresh_distros_file

# `compose up -d` can return a moment before the container reaches the
# running state, and `podman exec`/`attach` refuse to work on one that
# isn't running yet - so wait briefly for it.
for _ in {1..50}; do
    container_running "$DISTRO" && break
    sleep 0.1
done
container_running "$DISTRO" || die "container $(container_name "$DISTRO") did not reach the running state"

# Everything we run inside the container goes through this: `podman exec`
# only passes the container's configured environment (no /opt/ros/<distro>
# on PATH), so the ROS setup has to be sourced explicitly for commands like
# `ros2 topic list` to be found. An interactive shell does not need this -
# /root/.bashrc sources setup.bash for it.
in_container() {
    local tty=()
    if [[ -t 0 ]]; then
        tty+=(-i)
    fi
    if [[ -t 0 && -t 1 ]]; then
        tty+=(-t)
    fi
    "$ENGINE" exec ${tty[@]+"${tty[@]}"} "$(container_name "$DISTRO")" \
        bash -c 'if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then . "/opt/ros/${ROS_DISTRO}/setup.bash"; fi; exec "$@"' _ "$@"
}

if [[ $# -gt 0 ]]; then
    # One-off command: ./run jazzy -- ros2 topic list. It runs to completion
    # and stops here - without this explicit exit the script would fall
    # through to the attach below and launch tmux after the command returned.
    in_container "$@"
    exit 0
fi

if ! [[ -t 0 && -t 1 ]]; then
    warn "stdin is not a terminal - not attaching to $(container_name "$DISTRO")"
    info "Get a shell with: $ENGINE exec -it $(container_name "$DISTRO") bash"
    exit 0
fi

if (( NO_TMUX )); then
    info "Attached to $(container_name "$DISTRO") - plain shell, no tmux (exit with Ctrl-D)"
    exec "$ENGINE" exec -it "$(container_name "$DISTRO")" bash
fi

info "Attached to $(container_name "$DISTRO") - detach with Ctrl-g (tmux keeps running)"
# Ctrl-g instead of tmux's default Ctrl-b d: it is the detach key this
# script used to bind with `podman attach --detach-keys`, and Ctrl-Q is a
# terminal flow-control character that often gets swallowed before podman
# sees it (see tmux.conf for the binding). The session survives detaching,
# so the next './run <distro>' re-attaches to it.
exec "$ENGINE" exec -it "$(container_name "$DISTRO")" \
    bash -c 'if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then . "/opt/ros/${ROS_DISTRO}/setup.bash"; fi; exec tmux new-session -A -s ros2_session'
